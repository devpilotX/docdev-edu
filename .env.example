# ---------------------------------------------------------------------------
# DarkDev EDU — environment configuration
# Copy to .env.local for development, or set these in your hosting provider.
# ---------------------------------------------------------------------------

# Public site origin, used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://docdev:docdev@localhost:5432/docdev_edu?schema=public"

# Admin console credentials.
# Generate the hash with: npx tsx scripts/hash-password.ts "your-password"
ADMIN_EMAIL="admissions@docdev.edu"
ADMIN_PASSWORD_HASH=""

# 32+ character secret used to sign the admin session cookie.
# Generate with: openssl rand -base64 48
SESSION_SECRET=""

# Optional: forward every accepted enquiry to an external endpoint
# (CRM, automation platform, internal service). Disabled when empty.
INQUIRY_WEBHOOK_URL=""
INQUIRY_WEBHOOK_HEADER_NAME="x-api-key"
INQUIRY_WEBHOOK_HEADER_VALUE=""

# Optional rate limit tuning for the public enquiry endpoint.
INQUIRY_RATE_LIMIT_MAX="5"
INQUIRY_RATE_LIMIT_WINDOW_MS="600000"
